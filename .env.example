# Copy to .env (never commit .env) and fill in real values.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public domain served over HTTPS (Caddy fetches the certificate); PUBLIC_URL must be https://<DOMAIN>
DOMAIN=hms-transport.example
PUBLIC_URL=https://hms-transport.example
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# Set both to true for a typical SMTP provider on port 587.
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@hms-transport.example
# First start only: creates the first admin if no account exists with this e-mail. Remove afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# SMS reminders (24 h and 1 h before pickup); messages are only logged until a provider exists
SMS_ENABLED=false
SMS_PROVIDER=log

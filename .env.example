# Copy to .env (never commit .env) and fill in real values.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
PUBLIC_URL=https://marhba.example.tn
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# Set both to true for a typical SMTP provider on port 587.
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@marhba.tn
# First start only: creates the first admin if no account exists with this e-mail. Remove afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
